// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EProvider {
  LINKED_IN
  GREENHOUSE
  INDEED
  SEEK
  WORKDAY
  LEVER
  JOB_VISION
  IRAN_TALENT
  JOB_IN_JA
  E_ESTEKHDAM
}

enum ECrawlerStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum EJobStatus {
  ACTIVE
  EXPIRED
  CLOSED
  REMOVED
}

model Job {
  id             String     @id @default(cuid())
  title          String
  url            String     @unique
  contractType   String
  salary         String?
  postedAt       DateTime?
  provider       EProvider
  status         EJobStatus @default(ACTIVE)
  lastSeenAt     DateTime?
  lastVerifiedAt DateTime?
  expiredAt      DateTime?
  expiryReason   String?
  removalReason  String?
  archivedAt     DateTime?
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  locationId     String
  location       Location   @relation(fields: [locationId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, postedAt])
  @@index([provider, status, postedAt])
}

model Company {
  id          String  @id @default(cuid())
  fullName    String  @unique
  persianName String?
  englishName String?
  jobs        Job[]
}

model Location {
  id       String @id @default(cuid())
  country  String
  province String
  jobs     Job[]

  @@unique([country, province])
}

model CrawlerExecution {
  id         String         @id @default(cuid())
  status     ECrawlerStatus
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  error      String?
  createdAt  DateTime       @default(now())

  @@index([startedAt])
  @@index([status, startedAt])
}
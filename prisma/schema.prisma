// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EProvider {
  LINKED_IN
  GREENHOUSE
  INDEED
  SEEK
  WORKDAY
  LEVER
  JOB_VISION
  IRAN_TALENT
  JOB_IN_JA
  E_ESTEKHDAM
}

enum ECrawlerStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum EWorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum EVisaSponsorship {
  AVAILABLE
  NOT_AVAILABLE
}

enum EEducationLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  PHD
}

model Job {
  id           String    @id @default(cuid())
  title        String
  url          String    @unique
  contractType String
  salary       String?
  postedAt     DateTime?
  provider     EProvider
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  details      JobDetails?
}

model Company {
  id          String  @id @default(cuid())
  fullName    String  @unique
  persianName String?
  englishName String?
  jobs        Job[]
}

model Location {
  id       String @id @default(cuid())
  country  String
  province String
  jobs     Job[]

  @@unique([country, province])
}

model CrawlerExecution {
  id         String         @id @default(cuid())
  status     ECrawlerStatus
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  error      String?
  createdAt  DateTime       @default(now())

  @@index([startedAt])
  @@index([status, startedAt])
}

model JobDetails {
  id                        String            @id @default(cuid())
  description               String?
  responsibilities          String[]
  requirements              String[]
  preferredQualifications   String[]
  benefits                  String[]
  skills                    String[]
  experience                Experience?
  education                 EEducationLevel?
  workMode                  EWorkMode?
  visaSponsorship           EVisaSponsorship?
  applicationUrl            String?

  jobId                     String            @unique
  job                       Job               @relation(fields: [jobId], reference: [id], onDelete: Cascade)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

model Experience {
  id                        String            @id @default(cuid())
  raw                       String?
  min                       Int?
  max                       Int?

  jobDetailsId              String            @unique
  jobDetails                JobDetails        @relation(fields: [jobDetailsId], references: [id], onDelete: Cascade)
}